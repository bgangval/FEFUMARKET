<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.fefumarket">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FEFUMARKET">

        <!-- Edit / Add / My Posts -->
        <activity
            android:name=".ui.ad.EditPostActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ad.AddPostActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ad.MyPostsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ad.AdDetailActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ad"
                    android:scheme="fefumarket" />
            </intent-filter>
        </activity>

        <!-- Home / Filters -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.FiltersActivity"
            android:exported="false" />

        <!-- Favorites -->
        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:exported="false" />

        <!-- Chat -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.chat.MessageActivity"
            android:exported="false" />

        <!-- Profile -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <!-- Auth / Login -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.EmailInputActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.CodeVerificationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.PasswordCreationActivity"
            android:exported="false" />

        <!-- Loading / Launcher -->
        <activity
            android:name=".LoadingActivity"
            android:exported="true"
            android:theme="@style/Theme.FEFUMARKET">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
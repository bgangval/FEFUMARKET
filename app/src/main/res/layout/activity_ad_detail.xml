<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

        <!-- Верхний бар -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:paddingTop="40dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:background="@color/bottom_bar_bg"
            android:elevation="4dp"
            android:layout_gravity="top">

        <!-- Кнопка "Назад" -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            app:tint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Кнопка "Избранное" -->
        <ImageButton
            android:id="@+id/btnFavoriteTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_heart_top_bar"
            android:contentDescription="@string/to_favorites"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp" />

        <!-- Кнопка "Reply" -->
        <ImageButton
            android:id="@+id/btnChatTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_reply"
            android:contentDescription="@string/write"
            android:scaleType="centerInside"
            app:tint="@color/white" />
        </LinearLayout>

        <!-- Основная зона с прокруткой -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="110dp"
            android:clipToPadding="false"
            android:paddingBottom="90dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

        <!-- Фото -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/photoPager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            android:background="@color/light_gray" />

        <!-- Название -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:text="@string/sample_title"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_regular"
            android:background="@drawable/dark_rounded_field"
            app:layout_constraintTop_toBottomOf="@id/photoPager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Цена -->
        <TextView
            android:id="@+id/priceText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:text="@string/sample_price"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_regular"
            android:background="@drawable/dark_rounded_field"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Общежитие -->
        <TextView
            android:id="@+id/dormText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:text="@string/sample_dorm"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_regular"
            android:background="@drawable/dark_rounded_field"
            app:layout_constraintTop_toBottomOf="@id/priceText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Заголовок описания -->
        <TextView
            android:id="@+id/descTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/description"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_regular"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/dormText"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Описание -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:text="@string/sample_description"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:background="@drawable/dark_rounded_field_large"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toBottomOf="@id/descTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    <LinearLayout
        android:id="@+id/fixedButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="9dp"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/contactButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="@string/write"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_regular"
            android:backgroundTint="@color/button_blue"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoriteButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="@string/to_favorites"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_regular"
            android:backgroundTint="@color/button_blue"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"
            app:cornerRadius="24dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
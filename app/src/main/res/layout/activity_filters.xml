<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Верхний бар -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:orientation="horizontal"
        android:paddingTop="50dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@color/bottom_bar_bg"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back_button_desc"
            app:tint="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/filters_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_regular"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- ScrollView с фильтрами -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="130dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Выбор корпусов -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dorm_label"
                android:textColor="@color/light_gray"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat_regular"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/dormSelectText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_message"
                android:padding="16dp"
                android:text="Выберите корпуса"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:fontFamily="@font/montserrat_regular"/>

            <!-- Категории -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_label"
                android:textColor="@color/light_gray"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat_regular"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/categorySelectText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_message"
                android:padding="16dp"
                android:text="Выберите категории"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:fontFamily="@font/montserrat_regular"/>

            <!-- Состояние -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/condition_label"
                android:textColor="@color/light_gray"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat_regular"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/conditionSelectText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_message"
                android:padding="16dp"
                android:text="Выберите состояние"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:fontFamily="@font/montserrat_regular"/>

            <!-- Цена от и до -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_label"
                android:textColor="@color/light_gray"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat_regular"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/minPriceInput"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular"
                    android:inputType="number"
                    android:background="@drawable/bg_input_message"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_white"
                    android:hint="@string/min_price_hint"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/maxPriceInput"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular"
                    android:inputType="number"
                    android:background="@drawable/bg_input_message"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_white"
                    android:hint="@string/max_price_hint"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Контейнер для кнопок Сброс и Применить -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="24dp">

                <!-- Кнопка "Сброс" -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetFiltersButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Сброс"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/gray"
                    android:fontFamily="@font/montserrat_regular"
                    app:cornerRadius="28dp" />

                <!-- Кнопка "Применить" -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/applyFiltersButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/apply_button_text"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/button_blue"
                    android:fontFamily="@font/montserrat_regular"
                    app:cornerRadius="28dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Верхний бар -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="horizontal"
        android:paddingTop="40dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:background="@color/bottom_bar_bg"
        android:elevation="4dp"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_post"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:fontFamily="@font/montserrat_regular"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- Основная зона с прокруткой -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Слайдер фото (ViewPager2) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/photoPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/light_gray"/>

                <ImageButton
                    android:id="@+id/btnAddPhoto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="@string/change_photo"
                    app:tint="@color/white"/>
            </FrameLayout>

            <!-- Название товара -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Изменить название"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/title_hint"
                android:inputType="text"
                android:autofillHints="name"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/montserrat_regular"/>

            <!-- Цена -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Изменить цену"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/price_hint"
                android:inputType="number"
                android:autofillHints="postalCode"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/montserrat_regular"/>

            <!-- Описание -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Изменить описание"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/description_hint"
                android:inputType="textMultiLine"
                android:autofillHints="none"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/montserrat_regular"/>

            <!-- Корпус -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Изменить корпус"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/montserrat_regular"/>

            <Spinner
                android:id="@+id/spinnerDorm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:popupBackground="@color/white"
                android:layout_marginBottom="25dp"/>

            <!-- Категория -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Изменить категорию"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/montserrat_regular"/>

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:popupBackground="@color/white"
                android:layout_marginBottom="25dp"/>

            <!-- Состояние -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Изменить состояние"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/montserrat_regular"/>

            <Spinner
                android:id="@+id/spinnerCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:popupBackground="@color/white"
                android:layout_marginBottom="25dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Нижняя панель кнопок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp"
        android:gravity="center"
        android:weightSum="2"
        android:background="#00000000">

        <!-- Кнопка "Продано" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSold"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/sold"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/red"
            app:cornerRadius="28dp"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginEnd="8dp"/>

        <!-- Кнопка "Сохранить" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/save"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/button_blue"
            app:cornerRadius="28dp"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>